{
  "name": "korea-datamap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "cross-env BUILD_TARGET=android tsc -b && vite build",
    "build:web": "cross-env BUILD_TARGET=web tsc -b && vite build",
    "build:android": "cross-env BUILD_TARGET=android tsc -b && vite build",
    "build:mobile": "npm run build:android",
    "cap:sync": "npm run build:android && npx cap sync",
    "cap:android": "npm run build:android && npx cap sync android && npx cap open android",
    "cap:ios": "npm run build:android && npx cap sync ios && npx cap open ios",
    "fetch:age-data": "node scripts/fetchPopulationAgeData.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/ios": "^8.2.0",
    "@types/leaflet": "^1.9.21",
    "@types/proj4": "^2.5.6",
    "@types/recharts": "^1.8.29",
    "axios": "^1.13.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "proj4": "^2.20.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.2.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0"
  }
}
